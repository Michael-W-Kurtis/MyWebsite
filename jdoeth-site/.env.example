# Copy to .env and edit. Compose reads .env automatically.
#   cp .env.example .env

# ---- Identity --------------------------------------------------------------
OWNER_NAME=Michael W Kurtis
OWNER_EMAIL=mwmkurtis@gmail.com
GITHUB_URL=https://github.com/Michael-W-Kurtis

# ---- Networking ------------------------------------------------------------
# Host port the site is published on. http://localhost:8080
HTTP_PORT=8080
TZ=UTC

# ---- Image handling --------------------------------------------------------
# 12 MB. Keep nginx client_max_body_size above this or uploads fail with a bare 413.
MAX_UPLOAD_BYTES=12582912
# Long edge, in pixels. pixelsort costs roughly 4 microseconds per pixel, so
# 1600 keeps a worst-case sort near 8s. Raise it and raise JOB_TIMEOUT_SECONDS too.
MAX_IMAGE_DIM=1600
JOB_TIMEOUT_SECONDS=90
MAX_CONCURRENT_JOBS=2

# Uploads and results older than this are swept hourly. 0 disables the sweep.
RETENTION_HOURS=24

# ---- Stats privacy ---------------------------------------------------------
# The stats page publishes visitor IP addresses to anyone who loads it.
# STATS_MASK_IPS=true   drops the host octet: 203.0.113.47 -> 203.0.113.x
# STATS_TOKEN=<secret>  requires /stats?token=<secret>
# Read the "Before you expose this to the internet" section of the README.
STATS_MASK_IPS=false
STATS_TOKEN=

# Only these source ranges may set X-Real-IP. Default covers Docker's private
# networks. Do not add 0.0.0.0/0 — that lets any client forge its own address.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

# ---- Backups ---------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7
