# Copy to .env and edit. Compose reads .env automatically.
#   cp .env.example .env

# ---- Identity --------------------------------------------------------------
OWNER_NAME=Jonathan Doeth
OWNER_EMAIL=jonathan.doeth@gmail.com
GITHUB_URL=https://github.com/torvalds

# ---- Networking ------------------------------------------------------------
# Host port the site is published on. http://localhost:8080
HTTP_PORT=8080
TZ=UTC

# ---- Image handling --------------------------------------------------------
# 12 MB. Keep nginx client_max_body_size above this or uploads fail with a bare 413.
MAX_UPLOAD_BYTES=12582912
# Long edge, in pixels. pixelsort costs roughly 4 microseconds per pixel, so
# 1600 keeps a worst-case sort near 8s. Raise it and raise JOB_TIMEOUT_SECONDS too.
MAX_IMAGE_DIM=1600
JOB_TIMEOUT_SECONDS=90
MAX_CONCURRENT_JOBS=2

# Uploads and results older than this are swept hourly. 0 disables the sweep.
RETENTION_HOURS=24

# ---- Batch pixelsorter -----------------------------------------------------
# Cells render at the input's OWN resolution. This cap only stops accidents.
# Measured cost for 16 cells, serial / at 4 workers:
#   1600 px (1.6 MP)   1.8 min / 28 s
#   2400 px (3.6 MP)   3.5 min / 53 s
#   3200 px (6.4 MP)   7.1 min / 1.8 min
#   6000 px (22 MP)     25 min / 6.3 min
# Set to 0 to use the input's resolution with no cap at all.
BATCH_MAX_EDGE=3200

# The grid displays these instead of the full renders. Sixteen 6.4 MP images is
# 410 MB of decoded bitmap and will kill the browser tab. The download is always
# the real full-size PNG.
BATCH_VIEW_EDGE=900

# Its own pool, not shared with the single-image wrapper. Bounded by RAM rather
# than cores: roughly 0.71 GB resident per process at 3200 px.
BATCH_CONCURRENCY=4

# A 6.4 MP cell takes ~27s and a 22 MP one ~95s. Keep nginx proxy_read_timeout
# above this value.
BATCH_JOB_TIMEOUT=600

# Batch output is finished artwork, so it outlives the wrapper's 24h sweep.
# 0 keeps it forever.
BATCH_RETENTION_HOURS=168

# ---- Stats privacy ---------------------------------------------------------
# The stats page publishes visitor IP addresses to anyone who loads it.
# STATS_MASK_IPS=true   drops the host octet: 203.0.113.47 -> 203.0.113.x
# STATS_TOKEN=<secret>  requires /stats?token=<secret>
# Read the "Before you expose this to the internet" section of the README.
STATS_MASK_IPS=false
STATS_TOKEN=

# Only these source ranges may set X-Real-IP. Default covers Docker's private
# networks. Do not add 0.0.0.0/0 — that lets any client forge its own address.
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

# ---- Backups ---------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7
